usage() {
  cat <<EOF
Usage: $(basename "$0") [-m traditional|doh|both] [-d domain] [-n samples] [-t timeout]

Compare common public resolvers and suggest two from different providers.

Examples:
  $(basename "$0")
  $(basename "$0") -m doh
  $(basename "$0") -m both -d cloudflare.com -n 5

Options:
  -m MODE      traditional   port 53 via dig (default)
               doh           DNS over HTTPS via curl HTTP/2
               both          traditional, then DoH
  -d DOMAIN    Name to query (default: ${DOMAIN})
  -n SAMPLES   Timed queries per resolver, 1–20 (default: ${SAMPLES})
  -t SECONDS   Per-query timeout, 1–15
               Default is 2s for traditional and 5s for DoH
  -h           Show this help

Requirements:
  traditional  dig, awk
  doh          curl built with HTTP/2, python3, awk

What the numbers mean:
  Traditional mode reports dig query time for a NOERROR answer. The first
  query to each address is a warmup and is not counted.

  DoH mode sends one RFC 8484 POST (application/dns-message) per sample.
  Each sample opens a new connection. The table is ordered by DNS.
    TCP    curl time_connect
    TLS    curl time_appconnect, which already includes TCP
    DNS    time after the connection is ready until the DNS answer arrives
    Total  curl time_total: TCP, TLS, and the DNS answer
  With more than one sample, TCP, TLS, DNS, and Total are averages.
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is required"
}

positive_int() {
  local value=$1 min=$2 max=$3 label=$4
  [[ "$value" =~ ^[0-9]+$ ]] || die "$label must be an integer"
  ((value >= min && value <= max)) || die "$label must be between $min and $max"
}

query_time_ms() {
  local server=$1
  local output status qtime

  output=$(dig @"$server" "$DOMAIN" A +tries=1 +time="$TIMEOUT" +stats 2>/dev/null) || return 1
  status=$(awk '/;; ->>HEADER<<-/ { print; exit }' <<<"$output")
  [[ "$status" == *"status: NOERROR"* ]] || return 1
  qtime=$(awk '/^;; Query time:/ { print $4; exit }' <<<"$output")
  [[ "$qtime" =~ ^[0-9]+$ ]] || return 1
  echo "$qtime"
}

# Print "ok MIN AVG MAX COUNT" or "fail 0 0 0 0".
measure_dns() {
  local server=$1
  local times=()
  local sample i min=0 max=0 sum=0 avg=0

  query_time_ms "$server" >/dev/null || true

  for ((i = 0; i < SAMPLES; i++)); do
    if sample=$(query_time_ms "$server"); then
      times+=("$sample")
    fi
  done

  if ((${#times[@]} == 0)); then
    echo "fail 0 0 0 0"
    return 0
  fi

  min=${times[0]}
  max=${times[0]}
  for sample in "${times[@]}"; do
    sum=$((sum + sample))
    ((sample < min)) && min=$sample
    ((sample > max)) && max=$sample
  done
  avg=$(((sum + ${#times[@]} / 2) / ${#times[@]}))
  echo "ok $min $avg $max ${#times[@]}"
}

build_dns_query() {
  python3 - "$DOMAIN" "$QUERY_FILE" <<'PY'
import sys
domain, path = sys.argv[1], sys.argv[2]
header = (0x1234).to_bytes(2, "big") + (0x0100).to_bytes(2, "big") + (1).to_bytes(2, "big") + b"\x00" * 6
qname = b""
for part in domain.strip(".").split("."):
    label = part.encode("ascii")
    if not 1 <= len(label) <= 63:
        sys.exit(1)
    qname += bytes([len(label)]) + label
qname += b"\x00"
open(path, "wb").write(header + qname + b"\x00\x01\x00\x01")
PY
}

dns_answer_ok() {
  python3 - "$1" <<'PY'
import sys
data = open(sys.argv[1], "rb").read()
ok = len(data) >= 12 and (data[2] & 0x80) == 0x80 and (data[3] & 0x0F) == 0
sys.exit(0 if ok else 1)
PY
}

# Echo "HTTP TCP_SEC TLS_SEC PRE_SEC TOTAL_SEC BYTES" for one successful DoH query.
doh_once() {
  local url=$1
  local meta code tcp tls pre total bytes

  meta=$(curl -sS --http2 --max-time "$TIMEOUT" --connect-timeout "$TIMEOUT" \
    -o "$BODY_FILE" \
    -w '%{http_code} %{time_connect} %{time_appconnect} %{time_pretransfer} %{time_total}' \
    -H 'Content-Type: application/dns-message' \
    -H 'Accept: application/dns-message' \
    --data-binary @"$QUERY_FILE" \
    "$url") || return 1

  read -r code tcp tls pre total <<<"$meta"
  [[ "$code" == "200" ]] || return 1
  dns_answer_ok "$BODY_FILE" || return 1
  bytes=$(wc -c <"$BODY_FILE" | tr -d ' ')
  echo "$code $tcp $tls $pre $total $bytes"
}

# Print "ok DNS TOTAL TCP TLS HTTP COUNT BYTES" in milliseconds, or "fail".
measure_doh() {
  local url=$1
  local sample i
  local raw="$WORKDIR/samples"
  : >"$raw"

  doh_once "$url" >/dev/null || true
  for ((i = 0; i < SAMPLES; i++)); do
    if sample=$(doh_once "$url"); then
      echo "$sample" >>"$raw"
    fi
  done

  awk '
    { n++; http = $1; tcp += $2; tls += $3; pre += $4; tot += $5; bytes = $6 }
    END {
      if (n == 0) { print "fail"; exit }
      dns = (tot - pre) / n * 1000
      if (dns < 0) dns = 0
      printf "ok\t%.2f\t%.2f\t%.2f\t%.2f\t%s\t%d\t%d\n", dns, tot / n * 1000, tcp / n * 1000, tls / n * 1000, http, n, bytes
    }
  ' "$raw"
}

print_doh_table() {
  local state dns total tcp tls http ok bytes provider url
  printf '%-30s %-52s %5s %8s %8s %8s %9s %5s\n' \
    "Provider" "Endpoint" "HTTP" "TCP ms" "TLS ms" "DNS ms" "Total ms" "OK"
  printf '%-30s %-52s %5s %8s %8s %8s %9s %5s\n' \
    "------------------------------" "----------------------------------------------------" \
    "-----" "--------" "--------" "--------" "---------" "-----"
  while IFS=$'\t' read -r state dns total tcp tls http ok bytes provider url; do
    if [[ "$state" == "ok" ]]; then
      printf '%-30s %-52s %5s %8s %8s %8s %9s %5s\n' \
        "$provider" "$url" "$http" "$tcp" "$tls" "$dns" "$total" "${ok}/${SAMPLES}"
    else
      printf '%-30s %-52s %5s %8s %8s %8s %9s %5s\n' \
        "$provider" "$url" "fail" "-" "-" "-" "-" "0/${SAMPLES}"
    fi
  done < <(sort -t $'\t' -k1,1r -k2,2n "$DOH_ROWS")
  echo
}

macos_dns_service() {
  local service
  service=$(networksetup -listallnetworkservices 2>/dev/null | awk 'NR > 1 && $0 !~ /^\*/ { print; exit }')
  if [[ -n "$service" ]]; then
    printf '%s\n' "$service"
  else
    echo "Wi-Fi"
  fi
}

# RESULTS_FILE rows: state, avg, provider, target
suggest_pair() {
  local kind=$1
  local best_provider="" best_target="" best_avg=""
  local alt_provider="" alt_target="" alt_avg=""
  local state avg provider target

  while IFS=$'\t' read -r state avg provider target; do
    [[ "$state" == "ok" ]] || continue
    if [[ -z "$best_target" ]]; then
      best_provider=$provider
      best_target=$target
      best_avg=$avg
      continue
    fi
    if [[ -z "$alt_target" && "$provider" != "$best_provider" ]]; then
      alt_provider=$provider
      alt_target=$target
      alt_avg=$avg
      break
    fi
  done < <(sort -t $'\t' -k1,1r -k2,2n "$RESULTS_FILE")

  if [[ -z "$best_target" || -z "$alt_target" ]]; then
    die "fewer than two providers answered. Check connectivity and try a longer timeout (-t)."
  fi

  echo "Add these two (${kind}):"
  printf '  1. %s\n' "$best_target"
  printf '     %s, %s ms average\n' "$best_provider" "$best_avg"
  printf '  2. %s\n' "$alt_target"
  printf '     %s, %s ms average\n' "$alt_provider" "$alt_avg"
  echo

  if [[ "$kind" == "traditional DNS" ]]; then
    echo "Fastest addresses from two providers, so one outage leaves a resolver in place."
    echo
    if [[ "$(uname -s)" == "Darwin" ]] && command -v networksetup >/dev/null 2>&1; then
      local service
      service=$(macos_dns_service)
      echo "macOS (${service}):"
      echo "  sudo networksetup -setdnsservers \"$service\" $best_target $alt_target"
    else
      echo "systemd-resolved:"
      echo "  resolvectl dns IFACE $best_target $alt_target"
      echo
      echo "/etc/resolv.conf:"
      echo "  nameserver $best_target"
      echo "  nameserver $alt_target"
    fi
  else
    echo "Fastest DNS response times over HTTPS, from two providers."
    echo "Browsers take one custom URL: use the first, and keep the second as a fallback."
    echo
    echo "Chrome: Settings → Privacy and security → Security → Use secure DNS → With → custom"
    echo "Firefox: Settings → Privacy & Security → DNS over HTTPS → custom provider"
  fi
  echo
}

run_traditional() {
  require_cmd dig
  require_cmd awk
  TIMEOUT=$DNS_TIMEOUT
  : >"$RESULTS_FILE"
  : >"$DNS_ROWS"

  echo "Traditional DNS (port 53)"
  echo "  Domain:  $DOMAIN"
  echo "  Samples: $SAMPLES timed queries per address, after one warmup"
  echo "  Timeout: ${TIMEOUT}s"
  echo

  local entry provider ip state min avg max ok count=0 total=${#SERVERS[@]}
  for entry in "${SERVERS[@]}"; do
    provider=${entry%%|*}
    ip=${entry#*|}
    count=$((count + 1))
    printf '  [%2d/%2d] %-30s %s\n' "$count" "$total" "$provider" "$ip" >&2
    read -r state min avg max ok <<<"$(measure_dns "$ip")"
    if [[ "$state" == "ok" ]]; then
      printf 'ok\t%s\t%s\t%s\t%s\t%s\t%s\n' "$avg" "$provider" "$ip" "$min" "$max" "$ok" >>"$DNS_ROWS"
      printf 'ok\t%s\t%s\t%s\n' "$avg" "$provider" "$ip" >>"$RESULTS_FILE"
    else
      printf 'fail\t999999\t%s\t%s\t-\t-\t0\n' "$provider" "$ip" >>"$DNS_ROWS"
    fi
  done
  echo >&2

  printf '%-30s %-16s %8s %8s %8s %8s\n' "Provider" "Address" "Avg" "Min" "Max" "OK"
  printf '%-30s %-16s %8s %8s %8s %8s\n' "------------------------------" "----------------" "--------" "--------" "--------" "--------"
  while IFS=$'\t' read -r state avg provider ip min max ok; do
    if [[ "$state" == "ok" ]]; then
      printf '%-30s %-16s %8s %8s %8s %8s\n' \
        "$provider" "$ip" "${avg} ms" "${min} ms" "${max} ms" "${ok}/${SAMPLES}"
    else
      printf '%-30s %-16s %8s %8s %8s %8s\n' \
        "$provider" "$ip" "fail" "-" "-" "0/${SAMPLES}"
    fi
  done < <(sort -t $'\t' -k1,1r -k2,2n "$DNS_ROWS")
  echo
  suggest_pair "traditional DNS"
}

run_doh() {
  require_cmd curl
  require_cmd python3
  require_cmd awk
  TIMEOUT=$DOH_TIMEOUT
  curl --version | grep -q HTTP2 || die "curl is installed without HTTP/2; DoH needs it"
  build_dns_query
  : >"$RESULTS_FILE"
  : >"$DOH_ROWS"

  echo "DNS over HTTPS (RFC 8484, HTTP/2 POST)"
  echo "  Domain:  $DOMAIN"
  echo "  Samples: $SAMPLES timed queries per endpoint, after one warmup"
  echo "  Timeout: ${TIMEOUT}s"
  if ((SAMPLES > 1)); then
    echo "  Times:   averages of the successful samples"
  fi
  echo "  Order:   fastest DNS response time first"
  echo

  local entry provider url stats total count=0 total_n=${#DOH_SERVERS[@]}
  for entry in "${DOH_SERVERS[@]}"; do
    provider=${entry%%|*}
    url=${entry#*|}
    count=$((count + 1))
    printf '  [%2d/%2d] %-30s %s\n' "$count" "$total_n" "$provider" "$url" >&2
    stats=$(measure_doh "$url")
    if [[ "$stats" == fail ]]; then
      printf 'fail\t999999\t-\t-\t-\tfail\t0\t0\t%s\t%s\n' "$provider" "$url" >>"$DOH_ROWS"
    else
      printf '%s\t%s\t%s\n' "$stats" "$provider" "$url" >>"$DOH_ROWS"
      total=${stats#ok$'\t'}
      total=${total%%$'\t'*}
      printf 'ok\t%s\t%s\t%s\n' "$total" "$provider" "$url" >>"$RESULTS_FILE"
    fi
  done
  echo >&2

  print_doh_table
  suggest_pair "DNS over HTTPS"
}

main() {
  local opt
  while getopts ":m:d:n:t:h" opt; do
    case "$opt" in
      m) MODE=$OPTARG ;;
      d) DOMAIN=$OPTARG ;;
      n) SAMPLES=$OPTARG ;;
      t) TIMEOUT=$OPTARG; TIMEOUT_SET=1 ;;
      h) usage; exit 0 ;;
      *) usage >&2; exit 2 ;;
    esac
  done

  MODE=$(printf '%s' "$MODE" | tr '[:upper:]' '[:lower:]')
  case "$MODE" in
    traditional | doh | both) ;;
    *) die "mode must be traditional, doh, or both" ;;
  esac
  [[ "$DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]] || die "domain must be a hostname"
  positive_int "$SAMPLES" 1 20 "samples"
  if [[ "$TIMEOUT_SET" == 1 || -n "$TIMEOUT" ]]; then
    positive_int "$TIMEOUT" 1 15 "timeout"
    DNS_TIMEOUT=$TIMEOUT
    DOH_TIMEOUT=$TIMEOUT
  else
    DNS_TIMEOUT=2
    DOH_TIMEOUT=5
  fi

  WORKDIR=$(mktemp -d)
  trap 'rm -rf "$WORKDIR"' EXIT
  RESULTS_FILE="$WORKDIR/results"
  DNS_ROWS="$WORKDIR/dns-rows"
  DOH_ROWS="$WORKDIR/doh-rows"
  QUERY_FILE="$WORKDIR/query.bin"
  BODY_FILE="$WORKDIR/body.bin"

  case "$MODE" in
    traditional) run_traditional ;;
    doh) run_doh ;;
    both)
      run_traditional
      echo
      run_doh
      ;;
  esac
}

main "$@"
