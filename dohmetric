# RFC 8484 DNS-over-HTTPS endpoints. IP URLs are used where the certificate
# includes that address; the others are the provider's documented hostname.
# Providers listed only here did not answer on port 53.
DOH_SERVERS=(
  "Cloudflare|https://1.1.1.1/dns-query"
  "Cloudflare|https://1.0.0.1/dns-query"
  "Google|https://dns.google/dns-query"
  "Google|https://8.8.8.8/dns-query"
  "Google|https://8.8.4.4/dns-query"
  "Quad9|https://9.9.9.9/dns-query"
  "Quad9|https://149.112.112.112/dns-query"
