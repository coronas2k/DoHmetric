#!/usr/bin/env bash
# Benchmark public resolvers over traditional DNS (port 53) or DNS over HTTPS.
set -euo pipefail

DOMAIN="${DOMAIN:-example.com}"
SAMPLES="${SAMPLES:-5}"
TIMEOUT="${TIMEOUT:-}"
MODE="${MODE:-traditional}"
TIMEOUT_SET=0

# Traditional port-53 resolvers. One row per address.
SERVERS=(
